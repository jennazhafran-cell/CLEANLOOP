# Salin ke .env dan isi. File .env JANGAN di-commit ke git.
PORT=3000
NODE_ENV=development

# Midtrans (opsional). Kalau dikosongkan, mode simulasi aktif di development.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MODE=sandbox

# Simulasi pembayaran. Hanya berlaku saat NODE_ENV != production.
# Di production, nilai ini DIABAIKAN dan gateway wajib dikonfigurasi.
ALLOW_SIMULATED_PAYMENT=true

# Seed admin pertama (dipakai oleh `npm run seed`).
# GANTI dengan kredensial Anda sendiri.
ADMIN_NAME=Admin CleanLoop
ADMIN_EMAIL=admin@contoh.test
ADMIN_PASSWORD=GantiDenganYangKuat123